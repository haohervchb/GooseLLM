FROM nvidia/cuda:12.8.0-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/root/.cache/huggingface \
    VLLM_NO_USAGE_STATS=1 \
    CUDA_HOME=/usr/local/cuda-12.8 \
    PATH=/usr/local/cuda-12.8/bin:$PATH \
    LD_LIBRARY_PATH=/usr/local/cuda-12.8/lib64:$LD_LIBRARY_PATH \
    VLLM_TARGET_DEVICE=cuda \
    VLLM_MAIN_CUDA_VERSION=12.8 \
    TORCH_CUDA_ARCH_LIST=7.0 \
    MAX_JOBS=20 \
    NVCC_THREADS=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        software-properties-common \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        build-essential \
        ca-certificates \
        curl \
        git \
        wget \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        libssl-dev \
        zlib1g-dev \
        tini \
        python3.12 \
        python3.12-dev \
        python3-pip \
        python3.12-venv \
    && rm -rf /var/lib/apt/lists/* \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 \
    && update-alternatives --install /usr/bin/python python /usr/bin/python3.12 1

RUN curl -sS https://bootstrap.pypa.io/get-pip.py | python3 \
    && python3 -m pip install --upgrade pip setuptools wheel --break-system-packages

RUN if [ -d /usr/local/cuda-12.8 ]; then ln -sf /usr/local/cuda-12.8 /usr/local/cuda; fi

COPY requirements /tmp/requirements

RUN python3 -m pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu128 --break-system-packages

RUN python3 -m pip install -r /tmp/requirements/cuda.txt --break-system-packages

RUN python3 -m pip install 'setuptools>=77.0.3,<81.0.0' 'setuptools_scm>=8' grpcio-tools cmake build --break-system-packages

# ── Build TileLang from source with SM70 bf16 patches ────────────────────
ARG TILELANG_REPO=https://github.com/tile-ai/tilelang.git
ARG TILELANG_REF=main

RUN git clone --branch ${TILELANG_REF} --depth 1 ${TILELANG_REPO} /opt/tilelang

# Apply SM70 bf16 fallback patches (V100 has no native bf16 ALU)
# common.h: replace __hadd/__hmul/__hmax/__hmin etc with float fallbacks
RUN cd /opt/tilelang/src/tl_templates/cuda \
    && sed -i 's/return __nv_bfloat162{__hadd(a.x, b.x), __hadd(a.y, b.y)};/return __nv_bfloat162{__float2bfloat16_rn(__bfloat162float(a.x) + __bfloat162float(b.x)), __float2bfloat16_rn(__bfloat162float(a.y) + __bfloat162float(b.y))};/' common.h \
    && sed -i 's/return __nv_bfloat162{__hsub(a.x, b.x), __hsub(a.y, b.y)};/return __nv_bfloat162{__float2bfloat16_rn(__bfloat162float(a.x) - __bfloat162float(b.x)), __float2bfloat16_rn(__bfloat162float(a.y) - __bfloat162float(b.y))};/' common.h \
    && sed -i 's/return __nv_bfloat162{__hmul(a.x, b.x), __hmul(a.y, b.y)};/return __nv_bfloat162{__float2bfloat16_rn(__bfloat162float(a.x) * __bfloat162float(b.x)), __float2bfloat16_rn(__bfloat162float(a.y) * __bfloat162float(b.y))};/' common.h \
    && sed -i 's/return __nv_bfloat162{__hfma(a.x, b.x, c.x), __hfma(a.y, b.y, c.y)};/return __nv_bfloat162{__float2bfloat16_rn(__bfloat162float(a.x) * __bfloat162float(b.x) + __bfloat162float(c.x)), __float2bfloat16_rn(__bfloat162float(a.y) * __bfloat162float(b.y) + __bfloat162float(c.y))};/' common.h \
    && sed -i 's/return __nv_bfloat162{__hmax(a.x, b.x), __hmax(a.y, b.y)};/return __nv_bfloat162{__float2bfloat16_rn(fmaxf(__bfloat162float(a.x), __bfloat162float(b.x))), __float2bfloat16_rn(fmaxf(__bfloat162float(a.y), __bfloat162float(b.y)))};/' common.h \
    && sed -i 's/return __nv_bfloat162{__hmin(a.x, b.x), __hmin(a.y, b.y)};/return __nv_bfloat162{__float2bfloat16_rn(fminf(__bfloat162float(a.x), __bfloat162float(b.x))), __float2bfloat16_rn(fminf(__bfloat162float(a.y), __bfloat162float(b.y)))};/' common.h \
    && sed -i 's/return __nv_bfloat162{__habs(a.x), __habs(a.y)};/return __nv_bfloat162{__float2bfloat16_rn(fabsf(__bfloat162float(a.x))), __float2bfloat16_rn(fabsf(__bfloat162float(a.y)))};/' common.h \
    && sed -i 's/return bfloat16_t(__habs(x.to_nv_bfloat16()));/return bfloat16_t(fabsf(__bfloat162float(x.to_nv_bfloat16())));/' common.h

# reduce.h: SM70 bf16 Max/MinOp fallbacks (no __hmax_nan/__hmin_nan on SM70)
RUN cd /opt/tilelang/src/tl_templates/cuda \
    && sed -i 's/return bfloat16_t(__hmax(x.to_nv_bfloat16(), y.to_nv_bfloat16()));/return bfloat16_t(fmaxf(__bfloat162float(x.to_nv_bfloat16()), __bfloat162float(y.to_nv_bfloat16())));/' reduce.h \
    && sed -i 's/return bfloat16_t(__hmax_nan(x.to_nv_bfloat16(), y.to_nv_bfloat16()));/return bfloat16_t(fmaxf(__bfloat162float(x.to_nv_bfloat16()), __bfloat162float(y.to_nv_bfloat16())));/' reduce.h \
    && sed -i 's/return bfloat16_t(__hmin(x.to_nv_bfloat16(), y.to_nv_bfloat16()));/return bfloat16_t(fminf(__bfloat162float(x.to_nv_bfloat16()), __bfloat162float(y.to_nv_bfloat16())));/' reduce.h \
    && sed -i 's/return bfloat16_t(__hmin_nan(x.to_nv_bfloat16(), y.to_nv_bfloat16()));/return bfloat16_t(fminf(__bfloat162float(x.to_nv_bfloat16()), __bfloat162float(y.to_nv_bfloat16())));/' reduce.h \
    && sed -i '/return half_t(__hmax_nan(x.to_half(), y.to_half()));/i\#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 800) || defined(__hmax_nan)' \
    && sed -i '/__hmax_nan/,/};/{ /return half_t(__hmax_nan/ a\#else\n    return half_t(__hmax(x.to_half(), y.to_half()));\n#endif }' reduce.h || true \
    && (grep -q '__hmax_nan' reduce.h && sed -i 's/return half_t(__hmax_nan(x.to_half(), y.to_half()));/#if defined(__CUDA_ARCH__) \&\& (__CUDA_ARCH__ >= 800) || defined(__hmax_nan)\n    return half_t(__hmax_nan(x.to_half(), y.to_half()));\n#else\n    return half_t(__hmax(x.to_half(), y.to_half()));\n#endif/' reduce.h || true) \
    && (grep -q '__hmin_nan' reduce.h && sed -i 's/return half_t(__hmin_nan(x.to_half(), y.to_half()));/#if defined(__CUDA_ARCH__) \&\& (__CUDA_ARCH__ >= 800) || defined(__hmin_nan)\n    return half_t(__hmin_nan(x.to_half(), y.to_half()));\n#else\n    return half_t(__hmin(x.to_half(), y.to_half()));\n#endif/' reduce.h || true)

RUN cd /opt/tilelang && python3 -m pip install -e . --break-system-packages

WORKDIR /build

COPY . /build/

# ── Install TileLang FA-V100 kernels ─────────────────────────────────────
RUN cd /build && python3 -m pip install -e 3rdparty/tilelang-fa-v100/ --break-system-packages

RUN rm -rf build vllm.egg-info .deps

# Build SM70 kernel from in-tree source
RUN cd /build/csrc/flash_attention_v100 \
    && sed -i 's/if not torch.cuda.is_available():/if False: # if not torch.cuda.is_available():/' setup.py \
    && MAX_JOBS=4 CUDA_HOME=/usr/local/cuda CMAKE_CUDA_ARCHITECTURES=70 TORCH_CUDA_ARCH_LIST="7.0" \
       python3 -m pip install . --no-build-isolation --break-system-packages

# Build vLLM wheel using setup.py (avoids PEP 517 build isolation issues)
RUN cd /build \
    && rm -rf build vllm.egg-info .deps/*-build .deps/*-subbuild \
    && SETUPTOOLS_SCM_PRETEND_VERSION=0.0.3.dev0 \
       python3 setup.py bdist_wheel --dist-dir dist-cu128-sm70 \
    && python3 -m pip install dist-cu128-sm70/*.whl --no-deps --break-system-packages

WORKDIR /workspace
EXPOSE 8000

COPY docker/entrypoint.sm70.sh /usr/local/bin/entrypoint.sm70.sh
RUN chmod +x /usr/local/bin/entrypoint.sm70.sh

ENTRYPOINT ["tini", "--", "/usr/local/bin/entrypoint.sm70.sh"]
CMD []
